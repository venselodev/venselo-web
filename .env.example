# Public URL of this site (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3004

# The Venselo app (webcore): "Comenzar" goes to /sign-up, "Ingresar" to /sign-in
NEXT_PUBLIC_APP_URL=http://localhost:3003

# Optional booking link for "Agendar demo" (Calendly, Cal.com…). Empty = scroll to the contact form.
NEXT_PUBLIC_DEMO_URL=

# Contact form (Resend). Reuse webcore's key and a verified sender.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=web@venselo.com
CONTACT_TO_EMAIL=you@venselo.com
